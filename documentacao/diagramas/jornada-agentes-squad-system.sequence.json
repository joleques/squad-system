    { "id": "analista", "type": "backend", "label": "Analista", "sublabel": "define demanda" },
    { "id": "dev", "type": "messagebus", "label": "Dev", "sublabel": "testa e implementa" },
    { "id": "reviewer", "type": "security", "label": "Reviewer", "sublabel": "revisa qualidade" }
  ],
  "segments": [
    { "from": 150, "to": 330, "label": "1 / ENTENDER A DEMANDA" },
    { "from": 345, "to": 480, "label": "2 / APROVAR O PLANO" },
    { "from": 495, "to": 765, "label": "3 / IMPLEMENTAR E REVISAR" },
    { "from": 780, "to": 930, "label": "4 / VALIDAR A ENTREGA" }
  ],
  "messages": [
    { "from": "usuario", "to": "lider", "y": 205, "label": "Descreve a demanda", "variant": "emphasis" },
