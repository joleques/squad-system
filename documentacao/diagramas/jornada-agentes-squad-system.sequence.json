    { "from": "analista", "to": "lider", "y": 305, "label": "Demanda pronta", "variant": "return" },

    { "from": "lider", "to": "usuario", "y": 395, "label": "Apresenta o plano", "variant": "security" },
    { "from": "usuario", "to": "lider", "y": 450, "label": "Aprova o plano", "variant": "security" },

    { "from": "lider", "to": "dev", "y": 545, "label": "Autoriza a execução", "variant": "emphasis" },
    { "from": "dev", "to": "lider", "y": 595, "label": "Testes iniciais verdes", "variant": "return" },
    { "from": "lider", "to": "dev", "y": 645, "label": "Implementar com TDD", "variant": "emphasis" },
    { "from": "dev", "to": "reviewer", "y": 695, "label": "Envia para revisão", "variant": "emphasis" },
    { "from": "reviewer", "to": "lider", "y": 745, "label": "APROVADO técnico", "variant": "return" },

    { "from": "lider", "to": "usuario", "y": 830, "label": "Solicita validação", "variant": "emphasis" },
    { "from": "usuario", "to": "lider", "y": 890, "label": "Aceite explicito", "variant": "security" }
  ],
  "activations": [
    { "participant": "lider", "from": 195, "to": 320, "type": "frontend" },
    { "participant": "lider", "from": 385, "to": 470, "type": "frontend" },
    { "participant": "lider", "from": 535, "to": 755, "type": "frontend" },
    { "participant": "lider", "from": 820, "to": 900, "type": "frontend" },
    { "participant": "analista", "from": 225, "to": 315, "type": "backend" },
    { "participant": "dev", "from": 535, "to": 705, "type": "messagebus" },
    { "participant": "reviewer", "from": 685, "to": 755, "type": "security" }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Quando algo bloqueia",
      "items": [
        "Lacuna importante: o Líder pede somente a decisão necessária",
        "Testes iniciais falham: a implementação não começa",
        "Revisao tecnica reprova: retorna ao Dev, no máximo cinco vezes"
      ]
    },
    {
      "dot": "cyan",
      "title": "Se o usuário pedir um ajuste",
      "items": [
        "Ajuste pontual permanece no mesmo ticket",
        "Retorna direto para Dev e Reviewer",
        "Não exige nova análise nem Aprovar plano novamente"
      ]
    },
    {
      "dot": "emerald",
      "title": "Quando abrir outro trabalho",
      "items": [
        "Nova demanda somente para um objetivo independente",
        "Regressão causada pela entrega atual continua no mesmo ticket",
        "O usuário conversa apenas com o Líder durante todo o processo"
      ]
    }
  ]
}
